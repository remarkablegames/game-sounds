<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      Game Sounds &middot; {{ manifest.styles.length }} styles, {{
      manifest.sounds.length }} sounds
    </title>
    <link rel="stylesheet" href="css/style.css" />
  </head>
  <body>
    <main>{{ content | safe }}</main>
    <script
      src="https://unpkg.com/github-corners/dist/embed.min.js"
      data-href="https://github.com/remarkablegames/game-sounds"
      data-target="_blank"
      async
      defer
    ></script>
  </body>
</html>
